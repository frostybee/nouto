        },
        {
          "command": "nouto.openApiOutline.addSecurityScheme.openIdConnect",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add@14"
        },
        {
          "command": "nouto.openApiOutline.addComponent",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentSection\\b/ && !nouto.openApiOutlineHasErrors",
