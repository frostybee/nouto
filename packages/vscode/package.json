{
  "name": "nouto",
  "displayName": "Nouto",
  "description": "Open-source API client for REST, GraphQL, WebSockets, SSE and gRPC. Runs inside VS Code or as a standalone desktop app.",
  "version": "1.5.0",
  "publisher": "frostybee-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frostybee/nouto"
  },
  "icon": "images/icon.png",
  "homepage": "https://github.com/frostybee/nouto",
  "bugs": {
    "url": "https://github.com/frostybee/nouto/issues"
  },
  "galleryBanner": {
    "color": "#0c1a24",
    "theme": "dark"
  },
  "keywords": [
    "rest client",
    "http client",
    "api client",
    "graphql client",
    "websocket client",
    "sse",
    "grpc client",
    "rest",
    "api",
    "http",
    "graphql",
    "websocket",
    "grpc",
    "postman",
    "testing"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onView:nouto.sidebar",
    "onView:nouto.openApiOutline",
    "onCommand:nouto.importCurl",
    "onCommand:nouto.newRequest",
    "onCommand:nouto.openInJsonExplorer",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:yaml",
    "onCommand:nouto.newOpenApiSpec",
    "onCommand:nouto.openExampleOpenApiSpec",
    "onCommand:nouto.openApiPreview",
    "onCommand:nouto.generateCollectionFromOpenApi",
    "onCommand:nouto.generateOpenApiFromCollection",
    "onCommand:nouto.generateOpenApiFromHar",
    "onCommand:nouto.openApiDocsInBrowser",
    "onWebviewPanel:nouto.openApiPreviewPanel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nouto.newOpenApiSpec",
        "title": "New OpenAPI Specification",
        "category": "Nouto",
        "icon": "$(new-file)"
      },
      {
        "command": "nouto.openExampleOpenApiSpec",
        "title": "Open Example OpenAPI Specification",
        "category": "Nouto",
        "icon": "$(beaker)"
      },
      {
        "command": "nouto.openApiPreview",
        "title": "Open OpenAPI Preview",
        "category": "Nouto",
        "icon": "$(open-preview)"
      },
      {
        "command": "nouto.generateCollectionFromOpenApi",
        "title": "Generate Collection from OpenAPI",
        "category": "Nouto",
        "icon": "$(library)"
      },
      {
        "command": "nouto.generateOpenApiFromCollection",
        "title": "Generate OpenAPI from Collection",
        "category": "Nouto",
        "icon": "$(file-code)"
      },
      {
        "command": "nouto.generateOpenApiFromHar",
        "title": "Generate OpenAPI from HAR File",
        "category": "Nouto",
        "icon": "$(file-code)"
      },
      {
        "command": "nouto.openApiDocsInBrowser",
        "title": "Open OpenAPI Documentation in Browser",
        "category": "Nouto",
        "icon": "$(globe)"
      },
      {
        "command": "nouto.openApiOutline.refresh",
        "title": "Refresh Outline",
        "category": "Nouto",
        "icon": "$(refresh)"
      },
      {
        "command": "nouto.openApiOutline.sortAlphabetical",
        "title": "Sort Outline Alphabetically",
        "category": "Nouto",
        "icon": "$(list-ordered)"
      },
      {
        "command": "nouto.openApiOutline.sortDocumentOrder",
        "title": "Sort Outline by Document Order",
        "category": "Nouto",
        "icon": "$(list-flat)"
      },
      {
        "command": "nouto.openApiOutline.openSpec",
        "title": "Open OpenAPI Specification...",
        "category": "Nouto",
        "icon": "$(folder-opened)"
      },
      {
        "command": "nouto.openApiOutline.openSettings",
        "title": "OpenAPI Settings",
        "category": "Nouto",
        "icon": "$(gear)"
      },
      {
        "command": "nouto.openApiOutline.saveAs",
        "title": "Save Specification As...",
        "category": "Nouto",
        "icon": "$(save-as)"
      },
      {
        "command": "nouto.openApiOutline.closeSpec",
        "title": "Close Specification",
        "category": "Nouto",
        "icon": "$(close)"
      },
      {
        "command": "nouto.openApiOutline.tryOperation",
        "title": "Try Operation in Nouto",
        "category": "Nouto",
        "icon": "$(play)"
      },
      {
        "command": "nouto.openApiOutline.copyJsonPointer",
        "title": "Copy JSON Pointer",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addPath",
        "title": "Add Path...",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addOperation",
        "title": "Add Operation...",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addServer",
        "title": "Add Server...",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addTag",
        "title": "Add Tag...",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addSecurityRequirement",
        "title": "Add Security Requirement...",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addSecurityScheme",
        "title": "Add Security Scheme...",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addComponent",
        "title": "Add Component...",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addComponent.schemas",
        "title": "Add Schema",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addComponent.parameters",
        "title": "Add Parameter",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addComponent.responses",
        "title": "Add Response",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addComponent.examples",
        "title": "Add Example",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addComponent.requestBodies",
        "title": "Add Request Body",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addComponent.headers",
        "title": "Add Header",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addComponent.links",
        "title": "Add Link",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addComponent.callbacks",
        "title": "Add Callback",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addComponent.pathItems",
        "title": "Add Path Item",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addSecurityScheme.apiKey",
        "title": "Add Security Scheme: API Key",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addSecurityScheme.httpBearer",
        "title": "Add Security Scheme: HTTP Bearer",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addSecurityScheme.httpBasic",
        "title": "Add Security Scheme: HTTP Basic",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addSecurityScheme.oauth2AuthorizationCode",
        "title": "Add Security Scheme: OAuth2 Authorization Code",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addSecurityScheme.openIdConnect",
        "title": "Add Security Scheme: OpenID Connect",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.addWebhook",
        "title": "Add Webhook...",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.deletePath",
        "title": "Delete Path",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.deleteOperation",
        "title": "Delete Operation",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.deleteServer",
        "title": "Delete Server",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.deleteTag",
        "title": "Delete Tag",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.deleteSecurityRequirement",
        "title": "Delete Security Requirement",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.deleteComponent",
        "title": "Delete Component",
        "category": "Nouto"
      },
      {
        "command": "nouto.openApiOutline.deleteWebhook",
        "title": "Delete Webhook",
        "category": "Nouto"
      },
      {
        "command": "nouto.newRequest",
        "title": "New Request",
        "category": "Nouto",
        "icon": "$(add)"
      },
      {
        "command": "nouto.newCollection",
        "title": "New Collection",
        "category": "Nouto",
        "icon": "$(new-folder)"
      },
      {
        "command": "nouto.openRequest",
        "title": "Open Request",
        "category": "Nouto"
      },
      {
        "command": "nouto.openHistoryEntry",
        "title": "Open History Entry",
        "category": "Nouto"
      },
      {
        "command": "nouto.exportHistory",
        "title": "Export History",
        "category": "Nouto",
        "icon": "$(export)"
      },
      {
        "command": "nouto.importHistory",
        "title": "Import History",
        "category": "Nouto",
        "icon": "$(import)"
      },
      {
        "command": "nouto.importPostman",
        "title": "Import Postman Collection",
        "category": "Nouto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nouto.importPostmanEnvironment",
        "title": "Import Postman Environment",
        "category": "Nouto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nouto.exportPostman",
        "title": "Export to Postman",
        "category": "Nouto",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "nouto.importOpenApi",
        "title": "Import OpenAPI Specification",
        "category": "Nouto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nouto.importInsomnia",
        "title": "Import Insomnia Collection",
        "category": "Nouto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nouto.importHoppscotch",
        "title": "Import Hoppscotch Collection",
        "category": "Nouto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nouto.importCurl",
        "title": "Import from cURL",
        "category": "Nouto",
        "icon": "$(terminal)"
      },
      {
        "command": "nouto.importFromUrl",
        "title": "Import from URL",
        "category": "Nouto",
        "icon": "$(link)"
      },
      {
        "command": "nouto.importThunderClient",
        "title": "Import Thunder Client",
        "category": "Nouto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nouto.bulkExport",
        "title": "Bulk Export Collections",
        "category": "Nouto",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "nouto.exportNative",
        "title": "Export as Nouto Format",
        "category": "Nouto",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "nouto.importNative",
        "title": "Import Nouto Collection",
        "category": "Nouto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nouto.openMockServer",
        "title": "Open Mock Server",
        "category": "Nouto",
        "icon": "$(server)"
      },
      {
        "command": "nouto.benchmarkRequest",
        "title": "Benchmark Request",
        "category": "Nouto",
        "icon": "$(dashboard)"
      },
      {
        "command": "nouto.openCommandPalette",
        "title": "Search Requests",
        "category": "Nouto",
        "icon": "$(search)"
      },
      {
        "command": "nouto.switchToGlobalStorage",
        "title": "Switch to Global Storage",
        "category": "Nouto"
      },
      {
        "command": "nouto.switchToWorkspaceStorage",
        "title": "Switch to Workspace Storage (.nouto/)",
        "category": "Nouto"
      },
      {
        "command": "nouto.duplicateSelectedRequest",
        "title": "Duplicate Selected Request",
        "category": "Nouto"
      },
      {
        "command": "nouto.openSettings",
        "title": "Settings",
        "category": "Nouto",
        "icon": "$(gear)"
      },
      {
        "command": "nouto.importAuto",
        "title": "Import Collection (Auto-Detect)",
        "category": "Nouto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nouto.importHar",
        "title": "Import HAR File",
        "category": "Nouto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nouto.exportHar",
        "title": "Export as HAR",
        "category": "Nouto",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "nouto.importBruno",
        "title": "Import Bruno Collection",
        "category": "Nouto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nouto.exportBackup",
        "title": "Export Backup",
        "category": "Nouto",
        "icon": "$(archive)"
      },
      {
        "command": "nouto.importBackup",
        "title": "Restore from Backup",
        "category": "Nouto",
        "icon": "$(archive)"
      },
      {
        "command": "nouto.openInJsonExplorer",
        "title": "Open in JSON Explorer",
        "category": "Nouto",
        "icon": "$(json)"
      },
      {
        "command": "nouto.openEnvironments",
        "title": "Environments",
        "category": "Nouto",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "nouto.openAbout",
        "title": "About",
        "category": "Nouto",
        "icon": "$(info)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nouto-sidebar",
          "title": "Nouto",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "nouto-sidebar": [
        {
          "type": "webview",
          "id": "nouto.sidebar",
          "name": "API Testing",
          "contextualTitle": "Nouto API Testing"
        },
        {
          "id": "nouto.openApiOutline",
          "name": "OpenAPI Outline",
          "contextualTitle": "OpenAPI Outline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nouto.openApiOutline",
        "when": "!nouto.openApiOutlineHasDocument",
        "contents": "No outline to show yet.\n[Open OpenAPI Specification](command:nouto.openApiOutline.openSpec)\nOpen a valid OpenAPI 3.x document (JSON or YAML) to see its structure here.\nDon't have one yet? [Create a new OpenAPI specification](command:nouto.newOpenApiSpec).\nWant a ready-made spec to explore? [Open an example specification](command:nouto.openExampleOpenApiSpec)."
      }
    ],
    "keybindings": [
      {
        "command": "nouto.newRequest",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeViewlet == 'workbench.view.extension.nouto-sidebar'"
      },
      {
        "command": "nouto.importCurl",
        "key": "ctrl+u",
        "mac": "cmd+u"
      },
      {
        "command": "nouto.openCommandPalette",
        "key": "ctrl+k ctrl+k",
        "mac": "cmd+k cmd+k"
      },
      {
        "command": "nouto.duplicateSelectedRequest",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "focusedView == 'nouto.sidebar'"
      },
      {
        "command": "nouto.newCollection",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "activeViewlet == 'workbench.view.extension.nouto-sidebar'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nouto.openApiPreview",
          "when": "nouto.openApiActive && activeWebviewPanelId != 'nouto.openApiPreviewPanel'",
          "group": "navigation"
        },
        {
          "command": "nouto.generateCollectionFromOpenApi",
          "when": "nouto.openApiActive && activeWebviewPanelId != 'nouto.openApiPreviewPanel'",
          "group": "navigation"
        },
        {
          "command": "nouto.openApiDocsInBrowser",
          "when": "nouto.openApiActive && activeWebviewPanelId != 'nouto.openApiPreviewPanel'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "nouto.openApiOutline.sortAlphabetical",
          "when": "view == nouto.openApiOutline && !nouto.openApiOutlineSortAlphabetically",
          "group": "navigation@0"
        },
        {
          "command": "nouto.openApiOutline.sortDocumentOrder",
          "when": "view == nouto.openApiOutline && nouto.openApiOutlineSortAlphabetically",
          "group": "navigation@0"
        },
        {
          "command": "nouto.openApiOutline.refresh",
          "when": "view == nouto.openApiOutline",
          "group": "navigation@1"
        },
        {
          "command": "nouto.openApiPreview",
          "when": "view == nouto.openApiOutline",
          "group": "navigation@2"
        },
        {
          "command": "nouto.openApiOutline.openSettings",
          "when": "view == nouto.openApiOutline",
          "group": "navigation@3"
        },
        {
          "command": "nouto.openApiOutline.openSpec",
          "when": "view == nouto.openApiOutline",
          "group": "1_spec@1"
        },
        {
          "command": "nouto.openApiOutline.saveAs",
          "when": "view == nouto.openApiOutline",
          "group": "1_spec@2"
        },
        {
          "command": "nouto.newOpenApiSpec",
          "when": "view == nouto.openApiOutline",
          "group": "1_spec@3"
        },
        {
          "command": "nouto.openExampleOpenApiSpec",
          "when": "view == nouto.openApiOutline",
          "group": "1_spec@4"
        },
        {
          "command": "nouto.openApiOutline.closeSpec",
          "when": "view == nouto.openApiOutline && nouto.openApiOutlineHasDocument",
          "group": "1_spec@5"
        },
        {
          "command": "nouto.generateCollectionFromOpenApi",
          "when": "view == nouto.openApiOutline",
          "group": "9_actions@1"
        },
        {
          "command": "nouto.openApiDocsInBrowser",
          "when": "view == nouto.openApiOutline",
          "group": "9_actions@2"
        },
        {
          "command": "nouto.openApiOutline.openSettings",
          "when": "view == nouto.openApiOutline",
          "group": "z_settings@1"
        },
        {
          "command": "nouto.openEnvironments",
          "when": "view == nouto.sidebar",
          "group": "1_panels"
        },
        {
          "command": "nouto.openSettings",
          "when": "view == nouto.sidebar",
          "group": "1_panels"
        },
        {
          "command": "nouto.openMockServer",
          "when": "view == nouto.sidebar",
          "group": "1_panels"
        },
        {
          "command": "nouto.importAuto",
          "when": "view == nouto.sidebar",
          "group": "2_import_export"
        },
        {
          "command": "nouto.exportBackup",
          "when": "view == nouto.sidebar",
          "group": "2_import_export"
        },
        {
          "command": "nouto.importBackup",
          "when": "view == nouto.sidebar",
          "group": "2_import_export"
        },
        {
          "command": "nouto.openAbout",
          "when": "view == nouto.sidebar",
          "group": "3_info"
        }
      ],
      "view/item/context": [
        {
          "command": "nouto.openApiOutline.tryOperation",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineOperation\\b/",
          "group": "inline"
        },
        {
          "command": "nouto.openApiOutline.tryOperation",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineOperation\\b/",
          "group": "1_actions"
        },
        {
          "command": "nouto.openApiOutline.addPath",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlinePathsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add"
        },
        {
          "command": "nouto.openApiOutline.addOperation",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\b(outlinePath|outlineWebhook)\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add"
        },
        {
          "command": "nouto.openApiOutline.addServer",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineServersGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add"
        },
        {
          "command": "nouto.openApiOutline.addTag",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineTagsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add"
        },
        {
          "command": "nouto.openApiOutline.addSecurityRequirement",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineSecurityGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add"
        },
        {
          "command": "nouto.openApiOutline.addComponent.schemas",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add@1"
        },
        {
          "command": "nouto.openApiOutline.addComponent.parameters",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add@2"
        },
        {
          "command": "nouto.openApiOutline.addComponent.responses",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add@3"
        },
        {
          "command": "nouto.openApiOutline.addComponent.examples",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add@4"
        },
        {
          "command": "nouto.openApiOutline.addComponent.requestBodies",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add@5"
        },
        {
          "command": "nouto.openApiOutline.addComponent.headers",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add@6"
        },
        {
          "command": "nouto.openApiOutline.addComponent.links",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add@7"
        },
        {
          "command": "nouto.openApiOutline.addComponent.callbacks",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add@8"
        },
        {
          "command": "nouto.openApiOutline.addComponent.pathItems",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add@9"
        },
        {
          "command": "nouto.openApiOutline.addSecurityScheme.apiKey",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
