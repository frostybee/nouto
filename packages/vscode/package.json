        },
        {
          "command": "nouto.openApiOutline.addSecurityScheme.httpBasic",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "1_add@12"
        },
        {
          "command": "nouto.openApiOutline.addSecurityScheme.oauth2AuthorizationCode",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineComponentsGroup\\b/ && !nouto.openApiOutlineHasErrors",
