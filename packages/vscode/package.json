      "explorer/context": [
        {
          "command": "nouto.openInJsonExplorer",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "nouto.generateCollectionFromOpenApi",
          "when": "resourceExtname == .json || resourceExtname == .jsonc || resourceExtname == .yaml || resourceExtname == .yml",
          "group": "7_modification"
        },
        {
          "command": "nouto.generateOpenApiFromHar",
          "when": "resourceExtname == .har",
          "group": "7_modification"
        }
      ],
      "editor/title/context": [
        {
          "command": "nouto.openInJsonExplorer",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "nouto.openInJsonExplorer",
          "when": "resourceExtname == .json || editorLangId == json"
        },
        {
          "command": "nouto.openApiOutline.tryOperation",
          "when": "false"
        },
        {
          "command": "nouto.openApiOutline.copyJsonPointer",
          "when": "false"
        },
