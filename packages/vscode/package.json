        },
        {
          "command": "nouto.openApiOutline.deletePath",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlinePath\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "9_delete"
        },
        {
          "command": "nouto.openApiOutline.deleteOperation",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\b(outlineOperation|outlineWebhookOperation)\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "9_delete"
        },
        {
          "command": "nouto.openApiOutline.deleteServer",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineServer\\b/ && !nouto.openApiOutlineHasErrors",
          "group": "9_delete"
        },
        {
          "command": "nouto.openApiOutline.deleteTag",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineTag\\b/ && !nouto.openApiOutlineHasErrors",
