        },
        {
          "command": "nouto.openApiOutline.deleteSecurityRequirement",
          "when": "view == nouto.openApiOutline && viewItem =~ /\\boutlineSecurityRequirement\\b/ && !nouto.openApiOutlineHasErrors",
