---
import Landing from '../layouts/Landing.astro';
import Hero from '../components/Hero.astro';
import ProductShowcase from "../components/ProductShowcase.astro";
import Protocols from '../components/Protocols.astro';
import ValueProps from '../components/ValueProps.astro';
import FeatureList from '../components/FeatureList.astro';
import PrivacySection from '../components/PrivacySection.astro';
import ImportStrip from '../components/ImportStrip.astro';
import Footer from '../components/Footer.astro';

const protocols = ['HTTP', 'gRPC', 'GraphQL', 'WebSocket', 'SSE'];

const valueProps = [
  {
    icon: '🔒',
    title: 'Private',
    description: 'No account and no telemetry. Collections, environments, and history are saved as files on your machine.',
  },
  {
    icon: '📁',
    title: 'Git-friendly',
    description: 'In workspace storage, each request is its own JSON file under .nouto/, so commits and diffs stay small.',
  },
  {
    icon: '🔧',
    title: 'Automatable',
    description: 'Run collections, benchmarks, imports, exports, and code generation from the CLI.',
  },
];

const allFeatures = [
  { title: 'HTTP requests', desc: 'Standard and custom methods, with params, headers, body, auth, and per-request settings' },
  { title: 'gRPC', desc: 'Unary, client streaming, server streaming, and bidirectional calls from proto files or server reflection' },
  { title: 'GraphQL', desc: 'Queries, mutations, and subscriptions, with a schema explorer' },
  { title: 'WebSocket', desc: 'Text and binary messages, auto-reconnect, and session recording' },
  { title: 'Server-Sent Events', desc: 'Event stream with filtering and auto-reconnect' },
  { title: 'Environments', desc: 'Global, environment, and collection variables, dynamic values, and .env files' },
  { title: 'Collections', desc: 'Nested folders, drag and drop, and auth and headers inherited from folders' },
  { title: 'Assertions', desc: 'Check status, headers, body, JSONPath values, and response time without writing a script' },
  { title: 'Mock server', desc: 'Local endpoints for testing without a backend' },
  { title: 'Benchmarking', desc: 'Repeat a request with set iterations and concurrency, and read the latency percentiles' },
  { title: 'Code generation', desc: 'Request snippets for cURL, JavaScript, Python, Go, C#, Java, and more' },
  { title: 'OpenAPI editor', desc: 'Edit, lint, and preview OpenAPI 3.0, 3.1, and 3.2 specs, with autocomplete and hover docs' },
  { title: 'JSON Explorer', desc: 'Tree and table views with query filter, compare, and type generation' },
];

const comparison = [
  { feature: 'Telemetry', nouto: 'None', postman: 'Yes', thunder: 'Opt-out' },
  { feature: 'Account required', nouto: 'No', postman: 'Mostly', thunder: 'No' },
  { feature: 'Local storage', nouto: 'Yes', postman: 'Cloud-first', thunder: 'Yes' },
  { feature: 'Open source', nouto: 'MIT', postman: 'No', thunder: 'No' },
  { feature: 'Desktop app', nouto: 'Yes', postman: 'Yes', thunder: 'No' },
  { feature: 'gRPC', nouto: 'Yes', postman: 'Yes', thunder: 'Paid' },
  { feature: 'GraphQL', nouto: 'Yes', postman: 'Yes', thunder: 'Yes' },
  { feature: 'WebSocket / SSE', nouto: 'Yes', postman: 'Yes', thunder: 'Paid' },
];

const importSources = ['Postman', 'Insomnia', 'Hoppscotch', 'Thunder Client', 'Bruno', 'OpenAPI', 'cURL', 'HAR'];
---

<Landing title="Nouto | Open Source REST Client" description="Open-source API client for HTTP, gRPC, GraphQL, WebSocket, and SSE. Runs in VS Code, as a desktop app, and from the command line. No account, no telemetry.">
  <div class="page">
    <Hero />
    <ProductShowcase />
    <Protocols protocols={protocols} />
    <ValueProps features={valueProps} />
    <FeatureList features={allFeatures} />
    <PrivacySection comparison={comparison} />
    <ImportStrip sources={importSources} />
    <Footer />
  </div>
</Landing>

<style>
  .page {
    min-height: 100vh;
  }
</style>
