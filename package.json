{
  "name": "nouto-monorepo",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "compile": "pnpm run build:core && pnpm run build:transport && pnpm run compile:webview && pnpm run compile:extension",
    "compile:extension": "pnpm -F nouto run compile",
    "compile:webview": "pnpm -F @nouto/ui run build",
    "watch:extension": "pnpm -F nouto run watch",
    "watch:webview": "pnpm -F @nouto/ui run dev",
    "dev:desktop": "pnpm -F @nouto/desktop run dev:tauri",
    "build:desktop": "pnpm -F @nouto/desktop run build",
    "build:core": "pnpm -F @nouto/core run build",
    "build:transport": "pnpm -F @nouto/transport run build",
    "test": "pnpm -F @nouto/core run test && pnpm -F nouto run test",
    "test:all": "pnpm -F @nouto/core run test && pnpm -F nouto run test && pnpm -F @nouto/ui run test && pnpm -F @nouto/desktop run test",
    "test:desktop": "cd packages/desktop/src-tauri && cargo test --lib",
    "test:coverage": "pnpm -F @nouto/core run test && pnpm -F nouto run test:coverage",
    "clean": "pnpm -r exec rm -rf node_modules dist out build && rm -rf node_modules",
    "build:cli": "pnpm -F @nouto/cli run build",
    "package:nouto-ext": "cd packages/vscode && npx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "build:json-explorer-ext": "pnpm -F nouto-json-explorer run compile",
    "package:json-explorer-ext": "cd packages/json-explorer-ext && npx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "version:vscode": "npm version --prefix packages/vscode --no-git-tag-version",
    "start:docs": "pnpm -F @nouto/website run start",
    "verify:docs": "node scripts/verify-website-docs.mjs",
    "prepublish:docs": "pnpm run verify:docs && pnpm -F @nouto/website run build",
    "lint": "eslint packages/desktop",
    "lint:fix": "eslint packages/desktop --fix",
    "format": "prettier --write packages/desktop",
    "format:check": "prettier --check packages/desktop",
    "check:desktop": "pnpm -F @nouto/desktop run check",
    "rust:fmt": "cd packages/desktop/src-tauri && cargo fmt --all -- --check",
    "rust:clippy": "cd packages/desktop/src-tauri && cargo clippy --all-targets -- -D warnings",
    "release:desktop": "node scripts/prepare-desktop-release.mjs",
    "knip": "knip --workspace packages/desktop",
    "check:ui": "pnpm -F @nouto/ui run check"
  },
  "packageManager": "pnpm@11.21.0",
  "version": "0.0.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "knip": "^6.32.2",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.55.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0"
  }
}
